{
  "name": "kinan-vs-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kinan vs. Worlds overhaul - Phaser 3 + TypeScript + Vite shell (Milestone 1 foundation).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:legacy": "node ../tools/preview-server.mjs --root .. --port 8080",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
