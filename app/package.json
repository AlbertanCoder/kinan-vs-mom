{
  "name": "kinan-vs-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kinan vs. Worlds overhaul tooling. The real game is the legacy build in the repository root (legacy-first decision); the Phaser skeleton in src/ is shelved.",
  "scripts": {
    "start": "node ../tools/preview-server.mjs --root .. --port 4173",
    "preview": "node ../tools/preview-server.mjs --root .. --port 4173",
    "preview:legacy": "node ../tools/preview-server.mjs --root .. --port 8080",
    "dev:skeleton": "vite",
    "build:skeleton": "vite build",
    "preview:skeleton": "vite preview --port 4175",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:skeleton": "node -e \"process.env.KV_SKELETON='1';require('child_process').execSync('npx playwright test',{stdio:'inherit',env:process.env})\"",
    "check": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "levels": "node ../tools/levels-manifest.mjs",
    "levels:check": "node ../tools/levels-manifest.mjs --check"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
